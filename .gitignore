__pycache__/
*.pyc
.pytest_cache/

# Local runtime state - never commit the live cache/backups or secrets
jobs_cache.db
jobs_cache.db-shm
jobs_cache.db-wal
backups/
.env

# Old CRM export snapshots referenced by manual test scripts
Job_Outreach_CRM*.xlsx

# Task queue: the contract (.queue/README.md) is tracked, the task files are not.
# In-flight tasks are local state - committing them would put queue churn in every
# diff you review, and the worker's code changes are what you actually want to see.
.queue/*/*.md
