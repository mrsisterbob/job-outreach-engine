{
  "crossSessionInbound": "accept",
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/verify_suites.py\"",
            "timeout": 330,
            "statusMessage": "Checking both test suites before ending the turn..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/scope_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking the edit is inside the task's scope..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/git_write_guard.py\"",
            "timeout": 10,
            "statusMessage": "Checking git is read-only for the build agent..."
          }
        ]
      }
    ]
  }
}
