import os
import requests

def check_env_vars():
    print("🔍 Testing Environment Variables...")
    required = ["RAPIDAPI_KEY", "TELEGRAM_BOT_TOKEN", "TELEGRAM_CHAT_ID", "CRM_WEBHOOK_URL", "GMAIL_REFRESH_TOKEN"]
    missing = [var for var in required if not os.environ.get(var)]
    
    if missing:
        print(f"  ❌ Missing Secrets/Vars: {', '.join(missing)}")
        return False
    print("  ✅ All environment variables present.")
    return True

def test_jsearch_api():
    print("🔍 Testing JSearch API Connection...")
    key = os.environ.get("RAPIDAPI_KEY")
    if not key:
        print("  ⚠️ Skipped: RAPIDAPI_KEY missing.")
        return
    headers = {"X-RapidAPI-Key": key, "X-RapidAPI-Host": "jsearch.p.rapidapi.com"}
    try:
        r = requests.get("https://jsearch.p.rapidapi.com/search", headers=headers, params={"query": "test"}, timeout=5)
        if r.status_code == 200:
            print("  ✅ JSearch API connection successful.")
        else:
            print(f"  ❌ JSearch API failed with status: {r.status_code}")
    except Exception as e:
        print(f"  ❌ JSearch API error: {e}")

def test_telegram_bot():
    print("🔍 Testing Telegram Bot & Chat ID...")
    token = os.environ.get("TELEGRAM_BOT_TOKEN")
    chat_id = os.environ.get("TELEGRAM_CHAT_ID")
    if not token or not chat_id:
        print("  ⚠️ Skipped: Telegram credentials missing.")
        return
    url = f"https://api.telegram.org/bot{token}/sendMessage"
    payload = {"chat_id": chat_id, "text": "🤖 Diagnostic check: Telegram connection successful!"}
    try:
        r = requests.post(url, json=payload, timeout=5)
        if r.status_code == 200:
            print("  ✅ Telegram message delivered successfully.")
        else:
            print(f"  ❌ Telegram API failed: {r.text}")
    except Exception as e:
        print(f"  ❌ Telegram error: {e}")

def test_crm_webhook():
    print("🔍 Testing Google Apps Script CRM Webhook...")
    url = os.environ.get("CRM_WEBHOOK_URL")
    if not url:
        print("  ⚠️ Skipped: CRM_WEBHOOK_URL missing.")
        return
    test_payload = {
        "company": "Test Co",
        "title": "Diagnostic Specialist",
        "location": "Detroit, MI",
        "link": "https://example.com",
        "draft_id": "TEST_DRAFT_123"
    }
    try:
        r = requests.post(url, json=test_payload, timeout=5)
        if r.status_code == 200:
            print("  ✅ Google Sheets CRM webhook reachable.")
        else:
            print(f"  ❌ CRM Webhook returned status: {r.status_code}")
    except Exception as e:
        print(f"  ❌ CRM Webhook error: {e}")

if __name__ == "__main__":
    print("=== PIPELINE SYSTEM HEALTH CHECK ===\n")
    check_env_vars()
    test_jsearch_api()
    test_telegram_bot()
    test_crm_webhook()
    print("\n====================================")
